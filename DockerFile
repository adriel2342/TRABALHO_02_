FROM python:3.10-slim 

WORKDIR /Trabalho_02_final

COPY vulnerabilidades.py menu.py inventario.py equipamentos.py enums.py .

COPY requirements.txt . 

RUN pip install --no-cache-dir -r requirements.txt

EXPOSE 5000

CMD ["python", "vulnerabilidades.py", "menu.py", "inventario.py","equipamentos.py","enums.py"]